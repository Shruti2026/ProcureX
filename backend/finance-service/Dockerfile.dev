FROM maven:3.9-eclipse-temurin-21

# Copy root parent POM
WORKDIR /app
COPY pom.xml .

# Copy the module's pom.xml
COPY finance-service/pom.xml ./finance-service/

# Download dependencies (cached layer)
RUN mvn dependency:go-offline -B -pl finance-service -am

# Copy source code
COPY finance-service/src ./finance-service/src

EXPOSE 8085

# Run with spring-boot:run for dev mode with devtools auto-restart
ENTRYPOINT ["mvn", "spring-boot:run", "-pl", "finance-service", "-am", "-Dspring-boot.run.profiles=docker"]