FROM maven:3.9-eclipse-temurin-21

# Copy root parent POM
WORKDIR /app
COPY pom.xml .

# Copy the module's pom.xml
COPY procurement-service/pom.xml ./procurement-service/

# Download dependencies (cached layer)
RUN mvn dependency:go-offline -B -pl procurement-service -am

# Copy source code
COPY procurement-service/src ./procurement-service/src

EXPOSE 8083

# Run with spring-boot:run for dev mode with devtools auto-restart
ENTRYPOINT ["mvn", "spring-boot:run", "-pl", "procurement-service", "-am", "-Dspring-boot.run.profiles=docker"]