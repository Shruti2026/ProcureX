FROM maven:3.9-eclipse-temurin-21

# Copy root parent POM
WORKDIR /app
COPY pom.xml .

# Copy the module's pom.xml
COPY api-gateway/pom.xml ./api-gateway/

# Download dependencies (cached layer)
RUN mvn dependency:go-offline -B -pl api-gateway -am

# Copy source code
COPY api-gateway/src ./api-gateway/src

EXPOSE 8080

# Run with spring-boot:run for dev mode with devtools auto-restart
ENTRYPOINT ["mvn", "spring-boot:run", "-pl", "api-gateway", "-am", "-Dspring-boot.run.profiles=docker"]