FROM maven:3.9-eclipse-temurin-21

# Copy root parent POM
WORKDIR /app
COPY pom.xml .

# Copy the module's pom.xml
COPY notification-service/pom.xml ./notification-service/

# Download dependencies (cached layer)
RUN mvn dependency:go-offline -B -pl notification-service -am

# Copy source code
COPY notification-service/src ./notification-service/src

EXPOSE 8086

# Run with spring-boot:run for dev mode with devtools auto-restart
ENTRYPOINT ["mvn", "spring-boot:run", "-pl", "notification-service", "-am", "-Dspring-boot.run.profiles=docker"]