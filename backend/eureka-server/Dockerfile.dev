FROM maven:3.9-eclipse-temurin-21

# Copy root parent POM
WORKDIR /app
COPY pom.xml .

# Copy the module's pom.xml
COPY eureka-server/pom.xml ./eureka-server/

# Download dependencies (cached layer)
RUN mvn dependency:go-offline -B -pl eureka-server -am

# Copy source code
COPY eureka-server/src ./eureka-server/src

EXPOSE 8761

# Run with spring-boot:run for dev mode with devtools auto-restart
ENTRYPOINT ["mvn", "spring-boot:run", "-pl", "eureka-server", "-am", "-Dspring-boot.run.profiles=docker"]