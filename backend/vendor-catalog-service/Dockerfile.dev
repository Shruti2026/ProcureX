FROM maven:3.9-eclipse-temurin-21

# Copy root parent POM
WORKDIR /app
COPY pom.xml .

# Copy the module's pom.xml
COPY vendor-catalog-service/pom.xml ./vendor-catalog-service/

# Download dependencies (cached layer)
RUN mvn dependency:go-offline -B -pl vendor-catalog-service -am

# Copy source code
COPY vendor-catalog-service/src ./vendor-catalog-service/src

EXPOSE 8082

# Run with spring-boot:run for dev mode with devtools auto-restart
ENTRYPOINT ["mvn", "spring-boot:run", "-pl", "vendor-catalog-service", "-am", "-Dspring-boot.run.profiles=docker"]