FROM maven:3.9-eclipse-temurin-21

# Copy root parent POM
WORKDIR /app
COPY pom.xml .

# Copy the module's pom.xml
COPY identity-service/pom.xml ./identity-service/

# Download dependencies (cached layer)
RUN mvn dependency:go-offline -B -pl identity-service -am

# Copy source code
COPY identity-service/src ./identity-service/src

EXPOSE 8081

# Run with spring-boot:run for dev mode with devtools auto-restart
ENTRYPOINT ["mvn", "spring-boot:run", "-pl", "identity-service", "-am", "-Dspring-boot.run.profiles=docker"]