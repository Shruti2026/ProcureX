FROM maven:3.9-eclipse-temurin-21

# Copy root parent POM
WORKDIR /app
COPY pom.xml .

# Copy the module's pom.xml
COPY inventory-service/pom.xml ./inventory-service/

# Download dependencies (cached layer)
RUN mvn dependency:go-offline -B -pl inventory-service -am

# Copy source code
COPY inventory-service/src ./inventory-service/src

EXPOSE 8084

# Run with spring-boot:run for dev mode with devtools auto-restart
ENTRYPOINT ["mvn", "spring-boot:run", "-pl", "inventory-service", "-am", "-Dspring-boot.run.profiles=docker"]