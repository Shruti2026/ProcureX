# ─── Database ────────────────────────────────────────────────────────────────
# Shared MySQL root password used by all database containers
DB_PASSWORD=your_strong_db_password_here

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Signing secret — must be at least 32 characters (256 bits) for HS256
JWT_SECRET=your_jwt_secret_key_at_least_32_chars

# ─── SMTP (Notification Service email sending) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ─── Local dev alternative: Mailhog (catches emails, no real sending) ────────
# SMTP_HOST=mailhog
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
