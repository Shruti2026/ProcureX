# =============================================================================
# ProcureX — Production Environment Variables Template
# =============================================================================
# Copy this file to .env.production, fill in every value, and keep it on the
# Azure VM only. NEVER commit .env.production to version control.
#
# Generate a secure JWT secret with:
#   openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
# Strong password — no special shell characters ($, !, etc.) that break compose
MYSQL_ROOT_PASSWORD=change_me_strong_password

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_USER=procurex
RABBITMQ_PASSWORD=change_me_strong_password

# -----------------------------------------------------------------------------
# JWT (identity-service)
# -----------------------------------------------------------------------------
# Must be a 64-character hex string. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_64char_hex_secret

# -----------------------------------------------------------------------------
# Email / SMTP (notification-service)
# Use a Gmail App Password — NOT your Gmail account password.
# Enable 2FA on your Google account, then generate an App Password at:
#   https://myaccount.google.com/apppasswords
# -----------------------------------------------------------------------------
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# -----------------------------------------------------------------------------
# CORS (api-gateway)
# The public URL that the browser uses to reach the frontend.
# Comma-separated if multiple origins are needed (e.g. HTTP + HTTPS during migration).
# Example: http://procurex.eastus.cloudapp.azure.com
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://your-vm-domain-or-ip

# -----------------------------------------------------------------------------
# Frontend build (baked into the Vite bundle at image build time)
# Must point to the API Gateway's public URL.
# Example: http://procurex.eastus.cloudapp.azure.com:8080/api
# (or just /api if Nginx is configured to proxy /api → gateway)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://your-vm-domain-or-ip:8080/api
